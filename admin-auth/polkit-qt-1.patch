+// Which listener a cancellation is for, and which of its requests: the
+// cookie names the request, so an agent with several requests open (one
+// shown, others waiting) cancels the right one.
+struct CancelledData {
+    PolkitAgentListener *listener;
+    gchar *cookie;
+};
+
+static void cancelled_data_free(gpointer data)
+{
+    auto cancelled = static_cast<CancelledData *>(data);
+    g_free(cancelled->cookie);
+    g_free(cancelled);
+}
+
 static void cancelled_cb(GCancellable *cancellable, gpointer user_data)
 {
-    ListenerAdapter::instance()->cancelled_cb((PolkitAgentListener *)user_data);
+    auto cancelled = static_cast<CancelledData *>(user_data);
+    ListenerAdapter::instance()->cancelled_cb(cancelled->listener, cancelled->cookie);
 }
 
