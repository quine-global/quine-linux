-void ListenerAdapter::cancelled_cb(PolkitAgentListener *listener)
+void ListenerAdapter::cancelled_cb(PolkitAgentListener *listener, const gchar *cookie)
 {
     qDebug() << "cancelled_cb for " << listener;
 
     Listener *list = findListener(listener);
 
+    // A listener that handles several requests at once has a slot
+    // cancelAuthenticationForCookie(QString): cancel just the request with this
+    // cookie. Listener's own cancelAuthentication() can't say which one.
+    if (list->metaObject()->indexOfMethod("cancelAuthenticationForCookie(QString)") >= 0) {
+        QMetaObject::invokeMethod(list, "cancelAuthenticationForCookie", Qt::DirectConnection,
+                                  Q_ARG(QString, QString::fromUtf8(cookie)));
+        return;
+    }
+
     list->cancelAuthentication();
 }
 
