+void PolicyKitListener::cancelAuthenticationForCookie(const QString &cookie)
+{
+    qDebug() << "Cancelling authentication" << cookie;
+
+    if (m_inProgress && cookie == m_cookie) {
+        // As dialogCanceled(): the session too, so its helper stops asking.
+        m_wasCancelled = true;
+        if (!m_session.isNull()) {
+            m_session.data()->cancel();
+        }
+        finishObtainPrivilege();
+        return;
+    }
+    for (qsizetype i = 0; i < m_waiting.size(); ++i) {
+        if (m_waiting[i].cookie == cookie) {
+            finishWaiting(i, QString());
+            return;
+        }
+    }
