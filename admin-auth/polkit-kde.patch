+// Watches the process that asked (polkit's subject, which polkitd passes in
+// the details as polkit.subject-pid) with a pidfd, so a request whose asker
+// has exited is cancelled: its dialog closes instead of staying open with
+// nothing to answer, keeping every request after it waiting. polkitd cancels
+// such a request itself only when the subject or caller was a D-Bus name
+// that went away.
+void PolicyKitListener::watchSubject(Request &request)
+{
+    bool ok = false;
+    const int pid = request.details.lookup(QStringLiteral("polkit.subject-pid")).toInt(&ok);
+    if (!ok || pid <= 0) {
+        return;
+    }
+    const int fd = static_cast<int>(syscall(SYS_pidfd_open, pid, 0));
+    if (fd < 0) {
+        if (errno == ESRCH) {
+            // Already gone: cancel it once it's been queued or opened.
+            const QString cookie = request.cookie;
+            QTimer::singleShot(0, this, [this, cookie] {
+                subjectExited(cookie);
+            });
+        }
+        return;
+    }
+    request.subjectExited = new QSocketNotifier(fd, QSocketNotifier::Read, this);
+    const QString cookie = request.cookie;
+    connect(request.subjectExited, &QSocketNotifier::activated, this, [this, cookie] {
+        subjectExited(cookie);
+    });
+}
+
+void PolicyKitListener::stopWatching(QSocketNotifier *&notifier)
+{
+    if (notifier) {
+        notifier->setEnabled(false);
+        close(static_cast<int>(notifier->socket()));
+        notifier->deleteLater();
+        notifier = nullptr;
+    }
+}
+
+void PolicyKitListener::subjectExited(const QString &cookie)
+{
+    if (m_inProgress && cookie == m_cookie) {
+        qDebug() << "The process that asked for authentication has exited; closing its dialog";
+        dialogCanceled();
+        return;
+    }
+    for (qsizetype i = 0; i < m_waiting.size(); ++i) {
+        if (m_waiting[i].cookie == cookie) {
+            qDebug() << "The process that asked for authentication has exited; dropping its waiting request";
+            finishWaiting(i, i18n("The process that asked for authentication has exited."));
+            return;
+        }
+    }
+}
+
+// Ends a request that never got to open: with an error if one's given
+// (polkit then denies it), without when polkit cancelled it itself.
+void PolicyKitListener::finishWaiting(qsizetype index, const QString &error)
+{
+    Request request = m_waiting.takeAt(index);
+    stopWatching(request.subjectExited);
+    if (!error.isEmpty()) {
+        request.result->setError(error);
+    }
+    request.result->setCompleted();
+    delete request.result;
+}
+
+void PolicyKitListener::raiseDialog(const QString &activationToken)
+{
+    if (!m_dialog || !m_dialog->windowHandle()) {
+        return;
+    }
+    if (!activationToken.isEmpty()) {
+        qputenv("XDG_ACTIVATION_TOKEN", activationToken.toUtf8());
+    }
+    m_dialog->windowHandle()->raise();
+    m_dialog->windowHandle()->requestActivate();
+}
+
+void PolicyKitListener::notifyWaiting()
+{
+    auto notification = new KNotification(QStringLiteral("waiting"));
+    notification->setTitle(i18n("Authentication Required"));
+    notification->setText(i18n("Another program is waiting to ask for your password. Answer or cancel the open \"Authentication Required\" window first."));
+    notification->setIconName(QStringLiteral("dialog-password"));
+    auto show = notification->addDefaultAction(i18n("Show"));
+    connect(show, &KNotificationAction::activated, this, [this, notification] {
+        // The token from the click lets the dialog take focus on Wayland.
+        raiseDialog(notification->xdgActivationToken());
+    });
+    notification->sendEvent();
+}
