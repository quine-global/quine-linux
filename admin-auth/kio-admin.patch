 constexpr std::chrono::duration durationForWhichWeHonorAUsersChoice{5s};
+
+/**
+ * How long a call to the helper may take. Its first call asks for the password
+ * (polkit's dialog), and the helper takes one call at a time, so a call can
+ * wait for as long as someone takes to type a password, or to answer an
+ * earlier dialog first; D-Bus's default of 25 seconds failed such calls while
+ * the dialog was still open.
+ */
+constexpr int helperCallTimeoutMs = 10 * 60 * 1000;
+
+QDBusMessage callHelper(const QDBusMessage &request)
+{
+    return QDBusConnection::systemBus().call(request, QDBus::Block, helperCallTimeoutMs);
+}
+
+/** What a request that polkit turned down says, instead of "Access denied to ." */
+QString authorizationFailedText()
+{
+    return i18nc("@info", "Authentication as administrator failed or was cancelled.");
+}
