# Quine Linux's own apps (dnf-package-store, swap-watchdog), from the forge's
# `quine` RPM group. Forgejo signs the metadata, not the packages, so dnf
# checks the metadata, which pins each package's checksum.
[quine]
name=Quine Linux
baseurl=https://forge.in.quineglobal.com/api/packages/quine-global/rpm/quine
enabled=1
gpgcheck=0
repo_gpgcheck=1
gpgkey=https://forge.in.quineglobal.com/api/packages/quine-global/rpm/repository.key
